# AgentRelay local settings. Copy to .env (never commit secrets).
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
# One group only. Private messages are rejected even for allowed members.
TELEGRAM_CHAT_ID=-1001234567890
# Comma-separated numeric Telegram user IDs. No implicit access for other members.
ALLOWED_USER_IDS=123456789,987654321
# Local Git checkout Codex will read and edit. Relative to the bot folder.
CODEX_WORKDIR=../your-project
# Optional path to codex.exe; empty uses PATH or the VS Code bundled CLI.
CODEX_BIN=
# Empty model/effort uses the built-in Codex defaults (user config is not loaded).
# Use an exact model ID, e.g. gpt-6-sol (not a display name with spaces).
CODEX_MODEL=gpt-6-sol
CODEX_REASONING_EFFORT=medium
CODEX_SANDBOX=workspace-write
# Permit dependency downloads during development. Verification stays offline.
CODEX_NETWORK_ACCESS=false
# Enable host commit/push after verification when explicitly requested by a human.
CODEX_ALLOW_PUSH=false
CODEX_TIMEOUT_SECONDS=1800
CODEX_SESSION_FILE=.agent-relay-codex-session.json
# Names select the engine. Existing BOT_ALIASES use DEFAULT_BACKEND.
CODEX_ALIASES=Сударь
# Enable ordinary ChatGPT by filling CHAT_ALIASES and CWA_CONVERSATION_ID.
CHAT_ALIASES=
DEFAULT_BACKEND=codex
# Selected persistent ChatGPT chat: full https://chatgpt.com/c/<UUID> link or UUID.
# Replace this value while stopped, then restart to use a new chat.
CWA_CONVERSATION_ID=
CWA_AUTH_FILE=auth_data.json
CWA_MODEL=
CWA_REASONING_EFFORT=
CHAT_TIMEOUT_SECONDS=180
# Optional SQLite path for bounded public notes transferred when the chat changes.
# Empty derives *.chat.sqlite3 from STATE_FILE. Keep this file when changing chats.
CHAT_STATE_FILE=
# Optional one-line reminder added to the first human chat request after launch.
# Built-in startup briefing is always included; empty adds no custom reminder.
CHAT_STARTUP_PROMPT=
# Optional peer allowlist; both fields must be populated to accept another bot.
PEER_BOT_USERNAMES=
PEER_BOT_IDS=
MIN_INTERVAL_SECONDS=2
STATE_FILE=.agent-relay-state.json
# Optional task/mode SQLite path. Empty derives it from STATE_FILE (*.tasks.sqlite3).
TASK_STATE_FILE=
# Up to N previous trusted public messages per topic (0 disables).
# Persistent context keeps at most 32 recently active topics per group/bot.
GROUP_CONTEXT_LIMIT=30
# Optional private SQLite file for Telegram context across server restarts.
# Empty derives *.context.sqlite3 from STATE_FILE. Keep it when changing GPT chats.
GROUP_CONTEXT_FILE=
# Optional natural-language names for this bot, separate with commas
BOT_ALIASES=
